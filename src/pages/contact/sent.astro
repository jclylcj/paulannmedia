---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Message received - Paul Ann Media" description="We received your message." noindex={true}>
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <h1 class="text-4xl font-bold">Message received.</h1>
    <p class="mt-4 text-lg text-slate">Thank you. A person reads every message, and we'll reply at the email you gave us.</p>
    <a href="/" class="mt-8 inline-flex min-h-11 items-center font-semibold text-teal-ink hover:underline">Back to Paul Ann Media &rarr;</a>
  </section>
</Layout>
