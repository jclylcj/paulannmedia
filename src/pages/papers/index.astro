---
import Layout from '../../layouts/Layout.astro';

const papers = [
  {
    n: '01',
    href: '/papers/we-built-our-own-house-first/',
    title: 'We Built Our Own House First',
    sub: 'Building the websites for our own three brands hand in hand with the founder',
    date: '29 October 2026',
    blurb: 'What we built and when, who decided what, how the founder’s phone caught what a tool missed, and what we can’t claim yet ... including the numbers we have not measured.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Papers ... Paul Ann Media",
  "description": "Papers on our own work: building brands and websites with the founder, and what we can and can't claim.",
  "isPartOf": { "@type": "WebSite", "name": "Paul Ann Media", "url": "https://paulannmedia.com" },
  "hasPart": papers.map(p => ({
    "@type": "Article",
    "headline": p.title,
    "url": `https://paulannmedia.com${p.href}`,
    "datePublished": "2026-10-29"
  }))
};
---
<Layout
  title="Papers - Paul Ann Media"
  description="Papers on our own work: building brands and websites with the founder, and what we can and can't claim."
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-5 py-20">
    <h1 class="text-4xl font-bold">Papers</h1>
    <p class="mt-5 text-lg text-slate">
      How we work, written from our own brands.
    </p>
    <p class="mt-4 text-slate">
      We publish what we did, who decided it and what we measured. Where we have not measured
      something, we say so instead of implying a result.
    </p>

    <div class="mt-14 space-y-8">
      {papers.map(p => (
        <a href={p.href}
           class="block rounded-lg border border-navy/10 bg-white p-8 hover:border-teal transition-colors">
          <p class="text-sm font-semibold uppercase tracking-wide text-teal-ink">
            Paper {p.n} &middot; {p.date}
          </p>
          <h2 class="mt-2 text-2xl font-bold">{p.title}</h2>
          <p class="mt-2 text-slate">{p.sub}</p>
          <p class="mt-4 text-slate">{p.blurb}</p>
          <p class="mt-5 text-sm font-semibold text-teal-ink">Read the paper &rarr;</p>
        </a>
      ))}
    </div>

    <div class="mt-12">
      <p class="text-slate">
        <a href="https://paulannlabs.com/papers/" class="font-semibold text-teal-ink hover:underline">Paul
        Ann Labs publishes the other side</a> ... how the AI setup behind this work runs and gets checked.
      </p>
    </div>
  </article>
</Layout>
