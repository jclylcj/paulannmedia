---
import Layout from '../../layouts/Layout.astro';

const papers = [
  {
    n: '01',
    href: '/papers/the-website-wasnt-broken',
    title: "The Website Wasn't Broken. The System Around It Was.",
    sub: 'Turning a legacy recruiting presence into a measurable acquisition architecture without rebuilding from scratch',
    date: '8 August 2026',
    blurb: 'Traffic exists. Applications exist. And nobody can confidently explain what is producing what. A six-step method for making an accreted acquisition system legible — without a rebuild, a CMS change, or more spend.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Papers — Paul Ann Media",
  "description": "White papers on acquisition architecture, attribution, and evidence-based positioning.",
  "isPartOf": { "@type": "WebSite", "name": "Paul Ann Media", "url": "https://paulannmedia.com" },
  "hasPart": papers.map(p => ({
    "@type": "TechArticle",
    "headline": p.title,
    "url": `https://paulannmedia.com${p.href}`,
    "datePublished": "2026-08-08"
  }))
};
---
<Layout
  title="Papers — Paul Ann Media"
  description="White papers on acquisition architecture, attribution, and evidence-based positioning. A real question was put to AI Macx; here is the answer we were willing to publish."
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-5 py-20">
    <h1 class="text-4xl font-bold">Papers</h1>
    <p class="mt-5 text-lg text-slate">
      A real question was put to AI Macx. Here is the answer we were willing to publish.
    </p>
    <p class="mt-4 text-slate">
      Each paper takes a question we were actually handed by a client, and publishes the reasoning
      rather than the résumé. The client, the data, the economics, and the implementation stay out.
      The architecture, the diagnosis, and the things that went wrong stay in — including the ones
      still unresolved. Every paper carries a section on what failed, because a method that has only
      ever worked has not been run.
    </p>

    <div class="mt-14 space-y-8">
      {papers.map(p => (
        <a href={p.href}
           class="block rounded-lg border border-navy/10 bg-white p-8 hover:border-teal transition-colors">
          <p class="text-sm font-semibold uppercase tracking-wide text-teal">
            White Paper {p.n} &middot; {p.date}
          </p>
          <h2 class="mt-2 text-2xl font-bold">{p.title}</h2>
          <p class="mt-2 text-slate">{p.sub}</p>
          <p class="mt-4 text-slate">{p.blurb}</p>
          <p class="mt-5 text-sm font-semibold text-teal">Read the paper &rarr;</p>
        </a>
      ))}
    </div>

    <div class="mt-16 rounded-lg border border-navy/10 bg-white p-8">
      <h2 class="text-xl font-semibold">On what is withheld</h2>
      <p class="mt-3 text-slate">
        These papers are composites. They draw on more than one engagement, and no single client is
        described. Details that would identify a client have been changed or removed; details that
        would reveal implementation have been withheld. Where an outcome is stated, it is directional
        and drawn from work we actually did. Where we do not know something, we say so rather than
        redact it.
      </p>
    </div>

    <div class="mt-12">
      <p class="text-slate">
        The series continues on both sides of the house.
        <a href="https://paulannlabs.com/papers" class="font-semibold text-teal hover:underline">Paul
        Ann Labs publishes the operations side</a> — what an AI system inside a company is allowed to
        believe, and allowed to do.
      </p>
    </div>
  </article>
</Layout>
