---
// Contact form (Netlify Forms). Replaces the mailto link so no personal address is published.
// Netlify detects the form at build time; submissions arrive by the email notification set on the site.
const { button = 'Send' } = Astro.props;
---
<form
  name="contact"
  method="POST"
  data-netlify="true"
  netlify-honeypot="company-website"
  action="/contact/sent/"
  class="mx-auto mt-8 max-w-lg space-y-4 text-left"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden"><label>Leave this blank: <input name="company-website" /></label></p>
  <label class="block text-sm font-medium text-cream">Your name
    <input name="name" type="text" required autocomplete="name"
      class="mt-1 w-full min-h-11 rounded border border-white/20 bg-white px-3 text-navy focus:outline-none focus:ring-2 focus:ring-teal" />
  </label>
  <label class="block text-sm font-medium text-cream">Your email
    <input name="email" type="email" required autocomplete="email"
      class="mt-1 w-full min-h-11 rounded border border-white/20 bg-white px-3 text-navy focus:outline-none focus:ring-2 focus:ring-teal" />
  </label>
  <label class="block text-sm font-medium text-cream">Your business (optional)
    <input name="business" type="text" autocomplete="organization"
      class="mt-1 w-full min-h-11 rounded border border-white/20 bg-white px-3 text-navy focus:outline-none focus:ring-2 focus:ring-teal" />
  </label>
  <label class="block text-sm font-medium text-cream">What are you trying to do?
    <textarea name="message" rows="4" required
      class="mt-1 w-full rounded border border-white/20 bg-white px-3 py-2 text-navy focus:outline-none focus:ring-2 focus:ring-teal"></textarea>
  </label>
  <button type="submit" class="min-h-11 rounded bg-teal px-8 font-semibold text-navy hover:bg-teal-light transition-colors">{button}</button>
  <p class="text-xs text-slate-light">We use this only to reply to you. See our <a href="/privacy/" class="underline">privacy page</a>.</p>
</form>
