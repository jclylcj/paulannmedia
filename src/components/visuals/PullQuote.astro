---
interface Props {
  accent?: "media" | "labs";
  quote: string;
}
const { accent = "media", quote } = Astro.props;
const accentColor = accent === "labs" ? "#4A9D6E" : "#2AA09A";
---

<blockquote class="pa-pullquote" style={`--accent:${accentColor}`}>
  <span class="pa-pullquote__rule" aria-hidden="true"></span>
  <p>{quote}</p>
</blockquote>

<style>
  .pa-pullquote {
    margin: clamp(3rem, 8vw, 6rem) 0;
    padding: 0 0 0 1.4rem;
    border: 0;
    position: relative;
  }
  .pa-pullquote__rule {
    position: absolute;
    inset: .2rem auto .2rem 0;
    width: 3px;
    background: var(--accent);
  }
  .pa-pullquote p {
    margin: 0;
    max-width: 24ch;
    color: #1A2F3D;
    font-size: clamp(1.65rem, 3.2vw, 2.7rem);
    line-height: 1.12;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
</style>
