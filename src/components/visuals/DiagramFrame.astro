---
interface Props {
  ariaLabel: string;
  caption: string;
  minWidth?: number;
}

const {
  ariaLabel,
  caption,
  minWidth = 720,
} = Astro.props;
---

<figure class="pa-diagram">
  <div
    class="pa-diagram__scroll"
    role="region"
    aria-label={`Scrollable diagram: ${ariaLabel}`}
    tabindex="0"
  >
    <div class="pa-diagram__inner" style={`min-width:${minWidth}px`}>
      <slot />
    </div>
  </div>

  <div class="pa-diagram__affordance" aria-hidden="true">
    Scroll to explore <span>→</span>
  </div>

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .pa-diagram {
    margin: 2.5rem 0;
  }

  .pa-diagram__scroll {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    padding-bottom: 0.4rem;
  }

  .pa-diagram__inner {
    width: 100%;
  }

  .pa-diagram__inner :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .pa-diagram__affordance {
    display: none;
    margin-top: 0.5rem;
    color: #7C8A8A;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  figcaption {
    margin-top: 0.7rem;
    color: #7C8A8A;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .pa-diagram__affordance {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
  }
</style>
