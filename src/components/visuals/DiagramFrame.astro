---
interface Props {
  ariaLabel: string;
  caption: string;
  minWidth?: number;
}

const {
  ariaLabel,
  caption,
  minWidth = 720,
} = Astro.props;
---

<figure class="pa-diagram">
  <div
    class="pa-diagram__scroll"
    role="region"
    aria-label={`Scrollable diagram: ${ariaLabel}`}
    tabindex="0"
  >
    <div class="pa-diagram__inner" style={`min-width:${minWidth}px`}>
      <slot />
    </div>
  </div>

  <div class="pa-diagram__affordance" aria-hidden="true">
    Scroll to explore <span>→</span>
  </div>

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .pa-diagram {
    margin: 2.5rem 0;
  }

  /*
    Diagrams are wider than the prose column they sit in. Above the breakpoint,
    break out of the parent measure and centre on it, so the figure renders at
    its natural size instead of being scrolled and clipped on desktop.
    margin-left:50% + translateX(-50%) centres on the parent's centre line
    regardless of how narrow that parent is.
  */
  @media (min-width: 1024px) {
    .pa-diagram {
      width: min(1120px, 92vw);
      margin-left: 50%;
      transform: translateX(-50%);
    }
  }

  .pa-diagram__scroll {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    padding-bottom: 0.4rem;
  }

  .pa-diagram__inner {
    width: 100%;
  }

  .pa-diagram__inner :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .pa-diagram__affordance {
    display: none;
    margin-top: 0.5rem;
    color: #7C8A8A;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  figcaption {
    margin-top: 0.7rem;
    max-width: 68ch;
    color: #7C8A8A;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .pa-diagram__affordance {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
  }
</style>
