---
interface Props {
  ariaLabel: string;
  caption: string;
  minWidth?: number;
}

const {
  ariaLabel,
  caption,
  minWidth = 720,
} = Astro.props;
---

<figure class="pa-diagram">
  <div
    class="pa-diagram__scroll"
    role="region"
    aria-label={`Scrollable diagram: ${ariaLabel}`}
    tabindex="0"
  >
    <div class="pa-diagram__inner" style={`--pa-min:${minWidth}px`}>
      <slot />
    </div>
  </div>

  <div class="pa-diagram__affordance" aria-hidden="true">
    Scroll to explore <span>→</span>
  </div>

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .pa-diagram {
    margin: 2.5rem 0;
  }

  /*
    Diagrams are wider than the prose column they sit in. Above the breakpoint,
    break out of the parent measure and centre on it, so the figure renders at
    its natural size instead of being scrolled and clipped on desktop.
    margin-left:50% + translateX(-50%) centres on the parent's centre line
    regardless of how narrow that parent is.
  */
  @media (min-width: 1024px) {
    .pa-diagram {
      width: min(1120px, 92vw);
      margin-left: 50%;
      transform: translateX(-50%);
    }
  }

  .pa-diagram__scroll {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    padding-bottom: 0.4rem;
  }

  .pa-diagram__inner {
    width: 100%;
    min-width: var(--pa-min);
  }

  .pa-diagram__inner :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    On phones the figure scrolls regardless, so rendering it *smaller* than the
    source viewBox only shrinks the labels ... a 1000-unit viewBox drawn at 720px
    turns a 9.5px label into 7px. Force it to render slightly larger than the
    viewBox instead: the reader scrolls a little further and can actually read it.
  */
  @media (max-width: 640px) {
    .pa-diagram__inner {
      min-width: max(var(--pa-min), 1120px);
    }

    .pa-diagram__affordance {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
  }

  .pa-diagram__affordance {
    display: none;
    margin-top: 0.5rem;
    color: #5A6B6B;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /*
    The figure breaks out to 1120px above 1024px, so a caption that is simply a
    child of it starts at the BREAK-OUT left edge, not the prose column's ...
    three different left edges on one page. Re-centre the caption block on the
    prose measure (max-w-3xl 768px minus px-5 padding = 728px) so its left edge
    lands exactly on the body text. padding-right keeps the reading measure
    short without moving that left edge.
  */
  figcaption {
    width: min(728px, 100%);
    margin: 0.9rem auto 0;
    padding-right: max(0px, calc(100% - 34rem));
    color: #5A6B6B;
    font-size: 0.86rem;
    line-height: 1.5;
  }
</style>
