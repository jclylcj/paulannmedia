---
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-navy text-cream">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-lg font-bold">Paul Ann <span class="text-teal">Media</span></p>
        <p class="mt-3 max-w-xs text-sm text-slate-light">
          An AI-native media group. Built by operators who run real businesses,
          not by consultants describing them.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-teal">Company</p>
        <ul class="mt-2 text-sm">
          <li><a href="/services/" class="inline-flex min-h-11 items-center hover:text-teal">Services</a></li>
          <li><a href="/work/" class="inline-flex min-h-11 items-center hover:text-teal">Work</a></li>
          <li><a href="/papers/" class="inline-flex min-h-11 items-center hover:text-teal">Papers</a></li>
          <li><a href="/about/" class="inline-flex min-h-11 items-center hover:text-teal">About</a></li>
          <li><a href="/#contact" class="inline-flex min-h-11 items-center hover:text-teal">Contact</a></li>
          <li><a href="/privacy/" class="inline-flex min-h-11 items-center hover:text-teal">Privacy</a></li>
          <li><a href="/transparency/" class="inline-flex min-h-11 items-center hover:text-teal">Transparency</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-teal">Family</p>
        <ul class="mt-2 text-sm">
          <li><a href="https://hometimejobs.com" class="inline-flex min-h-11 items-center hover:text-teal">HomeTimeJobs</a></li>
          <li><a href="https://paulannlabs.com" class="inline-flex min-h-11 items-center hover:text-teal">Paul Ann Labs</a></li>
          <li><span class="inline-flex min-h-11 items-center text-slate-light">Trimmie Holdings</span></li>
        </ul>
      </div>
    </div>
    <p class="mt-12 border-t border-white/10 pt-6 text-xs text-slate-light">
      &copy; {year} Paul Ann Media - a Trimmie Holdings company. Photos on this site are AI-generated illustrations.
    </p>
  </div>
</footer>
