---
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-navy text-cream">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-lg font-bold">Paul Ann <span class="text-teal">Media</span></p>
        <p class="mt-3 max-w-xs text-sm text-slate">
          An AI-native media group. Built by operators who run real businesses,
          not by consultants describing them.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-teal">Company</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/services" class="hover:text-teal">Services</a></li>
          <li><a href="/work" class="hover:text-teal">Work</a></li>
          <li><a href="/about" class="hover:text-teal">About</a></li>
          <li><a href="/#contact" class="hover:text-teal">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-teal">Family</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="https://hometimejobs.com" class="hover:text-teal">HomeTimeJobs</a></li>
          <li><span class="text-slate">Paul Ann Labs</span></li>
          <li><span class="text-slate">Trimmie Holdings</span></li>
        </ul>
      </div>
    </div>
    <p class="mt-12 border-t border-white/10 pt-6 text-xs text-slate">
      &copy; {year} Paul Ann Media — a Trimmie Holdings company.
    </p>
  </div>
</footer>
